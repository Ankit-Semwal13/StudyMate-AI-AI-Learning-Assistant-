# Copy this file to .env and adjust as needed. Everything below is optional -
# sane free/local defaults are already baked into config.py.

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- faster-whisper (local speech-to-text) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# --- Embeddings (local, sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking ---
CHUNK_SIZE_WORDS=700
CHUNK_OVERLAP_WORDS=100

# --- RAG ---
RAG_TOP_K=4

# --- Downloads (yt-dlp retry-with-backoff on YouTube 403s/rate-limits) ---
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_DELAY_SECONDS=15

# --- FFmpeg ---
FFMPEG_BINARY=ffmpeg
